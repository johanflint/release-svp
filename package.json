{
  "name": "release-svp",
  "version": "0.1.0",
  "description": "Create pull requests based on Github labels",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johanflint/release-svp.git"
  },
  "homepage": "https://github.com/johanflint/release-svp#readme",
  "keywords": [
    "release-please",
    "release-automation",
    "changelog",
    "semver",
    "github-actions",
    "cli"
  ],
  "bin": {
    "release-svp": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google-automations/git-file-utils": "^3.0.0",
    "@rainbowatcher/toml-edit-js": "^0.6.4",
    "chalk": "^5.6.2",
    "code-suggester": "^5.0.0",
    "figures": "^6.1.0",
    "jsonc-parser": "^3.3.1",
    "octokit": "^5.0.5",
    "source-map-support": "^0.5.21",
    "yargs": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.34",
    "@vitest/coverage-v8": "^4.0.9",
    "chokidar-cli": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.3",
    "vite": "^7.2.4",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-raw": "^1.0.3",
    "vite-plugin-string": "^1.2.3",
    "vitest": "^4.0.9"
  }
}
